<odoo>
    <record id="payment_provider_form_sslcommerz" model="ir.ui.view">
        <field name="name">payment.provider.form.sslcommerz</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr='//group[@name="provider_credentials"]' position='inside'>
                <group invisible="code != 'sslcommerz'">
                    <field name="sslcommerz_store_id" required="code == 'sslcommerz' and state != 'disabled'"/>
                    <field name="sslcommerz_store_password" password="True" required="code == 'sslcommerz' and state != 'disabled'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
